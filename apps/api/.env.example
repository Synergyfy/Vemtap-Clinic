# =============================================================================
# Vemtap Health Clinic - API Environment Configuration
# =============================================================================
# Copy to .env in this directory (apps/api) and fill in the values:
#   cp .env.example .env
# The frontend has its own file: apps/web/.env.example
#
# Only DATABASE + JWT_SECRET are required for the API to start; everything
# else is optional or has a default. All values below are placeholders.
# =============================================================================

# =============================================================================
# APPLICATION
# =============================================================================
# development enables TypeORM synchronize, SQL logging and dev seed data.
# production makes auth cookies Secure (HTTPS only).
NODE_ENV=development
PORT=3001
# Frontend origin(s) allowed to call the API. Separate multiple with commas.
CORS_ORIGIN=http://localhost:3000
# Used to build links in emails (password reset, patient portal login)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE (Required - PostgreSQL)
# =============================================================================
# Option A: local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=vemtap_health

# Option B: Supabase (or any remote Postgres) — paste the connection string
# from Supabase Dashboard → Project Settings → Database → Connection string (URI).
# When set, it takes precedence and the DB_HOST/DB_USERNAME/... values above are not required.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional, defaults to require for remote hosts: disable|allow|require|verify-ca|verify-full
# DB_SSL=require

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# EMAIL (Optional - needed for password resets, receipts, notifications)
# =============================================================================
# EMAIL_PROVIDER=smtp|resend. Defaults to smtp when SMTP_HOST is set, otherwise resend.
#
# Recommended: Brevo SMTP (free tier, 300 emails/day)
#   1. Create an account at https://app.brevo.com
#   2. Settings -> SMTP & API -> SMTP tab -> generate an SMTP key
#   3. Settings -> Senders & Domains -> verify your domain (SPF + DKIM records)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="Vemtap Health Clinic"

# Alternative: Resend API (free tier, 3,000 emails/month)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx

# =============================================================================
# FILE STORAGE (Optional - defaults to local disk)
# =============================================================================
# local: files saved under UPLOAD_DIR (not suitable for hosts with ephemeral disks)
# cloudinary: files stored privately and served via short-lived signed URLs.
#   Credentials: Cloudinary Console -> Settings -> API Keys.
#   To serve PDFs, enable "Allow delivery of PDF and ZIP files" under Settings -> Security.
FILE_STORAGE_PROVIDER=local
# UPLOAD_DIR=./uploads

# Required when FILE_STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# PAYMENTS (Optional - Paystack; payment endpoints fail without it)
# =============================================================================
# Keys from Paystack Dashboard -> Settings -> API Keys & Webhooks
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx

# =============================================================================
# SMS (Optional)
# =============================================================================
# SMS_PROVIDER=twilio|termii|africastalking (defaults to twilio)
# SMS_PROVIDER=termii

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Termii (Nigeria)
# TERMII_API_KEY=
# TERMII_SENDER_ID=VemtapClinic

# Africa's Talking
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=

# =============================================================================
# HMO INTEGRATIONS
# =============================================================================
# No env needed — configured per clinic via the API at /api/hmo-integrations.
